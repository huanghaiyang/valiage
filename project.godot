[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Cozy Vale"
config/description="卡通风格无网格搭建沙盒游戏"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Game="*res://scripts/game.gd"
Settings="*res://scripts/settings.gd"
_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"
Weather="*res://scripts/world/weather.gd"
StaffSystem="*res://scripts/staff_system.gd"
Elders="*res://scripts/world/elders.gd"
SimpleGrass="*uid://bfq0snth8sj3h"
Quality="*res://scripts/quality/quality_manager.gd"
GameSettings="*res://scripts/settings/game_settings.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/blender_bridge/plugin.cfg", "res://addons/concave_collision_tuner/plugin.cfg", "res://addons/crash_monitor/plugin.cfg", "res://addons/exr_tools/plugin.cfg", "res://addons/glb_tools/plugin.cfg", "res://addons/godot_ai/plugin.cfg", "res://addons/image_convert/plugin.cfg", "res://addons/image_tools/plugin.cfg", "res://addons/simplegrasstextured/plugin.cfg", "res://addons/sky_3d/plugin.cfg", "res://addons/stuck_monitor/plugin.cfg", "res://addons/terrain_3d/plugin.cfg", "res://addons/world_brush/plugin.cfg")

[importer_defaults]

3d_texture={
&"compress/high_quality": true,
&"compress/mode": 2
}
texture={
&"compress/high_quality": true,
&"compress/mode": 2,
&"mipmaps/generate": true
}

[input]

ui_cancel={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194305,"key_label":0,"unicode":27,"location":0,"echo":false,"script":null)
]
}
stuck_monitor_toggle={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":76,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

[layer_names]

3d_render/layer_17="SimpleGrassTextured interactive layer"

[rendering]

textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.62, 0.78, 0.88, 1)
renderer/anti_aliasing/quality/msaa_3d=1

